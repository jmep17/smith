#!/bin/sh
# Enforce Conventional Commits: https://www.conventionalcommits.org
# <type>[optional scope][!]: <description>   (subject <= 72 chars)
msg_file="$1"
subject=$(head -n1 "$msg_file")

# Allow merges, reverts generated by git, and fixup/squash commits.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./-]+\))?!?: .{1,72}$'
if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject does not follow Conventional Commits:" >&2
  echo "  $subject" >&2
  echo "expected: <type>(<scope>)?: <description>  e.g. 'feat(tools): add WebFetch'" >&2
  echo "types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
